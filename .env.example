# Copy to .env.local. Never commit .env.local or service account keys.
# Supabase dashboard > Project settings > API. Select Mumbai when creating the project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: Supabase secret key (or legacy service_role key).
# Used only for extraction records and internal status updates after checking user access.
SUPABASE_SECRET_KEY=

# Server-only Vertex AI configuration. Use Application Default Credentials.
# Verify current model availability and processing-location terms before selecting it.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
VERTEX_MODEL=
# Locally authenticate with: gcloud auth application-default login
# Production: attach a least-privilege service account to Cloud Run.
# Do not use NEXT_PUBLIC_ for AI credentials or model service secrets.
